<html>
  <head>
    <title></title>
    <script>
      function f() {
        var v1 = parseInt(document.getElementById("t1").value);
        var v2 = parseInt(document.getElementById("t2").value);
        
        if((isNaN(v1)) || (isNaN(v2)))
          alert("Enter valid value(s)");
        else {
          var table = "Number  |  Square  |  Cube\n"
          for(i = v1; i <= v2; i++) {
            const sq = i * i;
            const cu = i * i * i;
            table += `${i}            |  ${sq}            |  ${cu}\n`;
          }
          alert(table);
        }
      }
    </script>
  </head>
  
  <body>
    Enter the first value <input type = "text" id = "t1"><br>
    Enter the second value <input type = "text" id = "t2"><br><br>
    <input type = "button" value = "click" onClick = "f()">
  </body>
</html>
