<html>
  <head><title></title>
  <script>
    function f () {
      var v1 = parseInt(document.getElementById ("t1").value);
      var v2 = parseInt(document.getElementById ("t2").value);
      var m = document.getElementById ("t3");
      var d = document.getElementById ("t4");
      if (isNaN(v1) || isNaN(v2)) {
        alert("Enter some correct value. Textbox can not be null.");
      }
      
      m.value = v1 * v2;
      d.value = v1 / v2;
    }
  </script>

  <body>
    Enter first value <input type = "text" id = "t1"> <br>
    Enter second value <input type = "text" id = "t2"> <br>
    &nbsp&nbsp&nbsp&nbsp<input type = "button" value = "click" onClick = "f ()"> <br>
    Multiplication <input type = "text" id = "t3">
    &nbsp&nbsp&nbsp&nbsp&nbsp
    Division <input type = "text" id = "t4">
  </body>
</html>
