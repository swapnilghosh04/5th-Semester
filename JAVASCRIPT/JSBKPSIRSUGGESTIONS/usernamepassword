<html>
  <head>
    <title></title>
    <script>
      function f() {
        var u = document.getElementById("t1").value;
        var p = document.getElementById("t2").value;
        const re1 = /^[a-z][a-zA-Z0-9_.-]{4,19}$/;
        const re2 = /^[a-zA-Z0-9!@#$%^&*]{8,}$/;
        
        if ((u == "") || (p == ""))
          alert("Textbox(es) can not be blank.");
        else if ((!re1.test(u)) || (!re2.test(p)))
          alert("Enter valid value(s).");
        else
          document.write("Your details are correct ;)");
      }
    </script>
  </head>
  
  <body>
    Enter username <input type = "text" id = "t1">
    <br>
    Enter password <input type = "text" id = "t2">
    <br><br>
    <input type = "button" value = "click" onClick = "f()">
</html>
