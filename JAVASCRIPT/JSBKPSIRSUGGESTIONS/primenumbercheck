<html>
  <head>
    <title></title>
    <script>
      function f() {
        var a = parseInt(document.getElementById("t1").value);
        var count = 0;
        
        for(i = 1; i <= a; i++) {
          if(a % i == 0)
            count++;
        }
        if(count == 2)
          document.write("The number " + a + " is prime.");
        else
          document.write("The number " + a + " is not prime.");
      }
    </script>
  </head>
  
  <body>
    Enter a number <input type = "text" id = "t1">
    <br><br>
    <input type = "button" value = "click" onClick = "f()">
  </body>
</html>
