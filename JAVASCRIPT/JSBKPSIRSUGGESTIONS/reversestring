<html>
  <head><title></title>
  <script>
    function f () {
      var str = document.getElementById ("t1").value;
      var str1 = "";
      for (i = str.length-1; i>=0; i--) {
        str1 = str1 + str.charAt(i);
      }
      document.write ("The reversed string is : " + str1);
    }
  </script>
  </head>
  
  <body>
    Enter string <input type = "text" id = "t1">
    <br>
    <input type = "button" value = "click" onClick = "f ()">
  </body>
</html>
